# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# original, pre-optimization 3D assets (kept locally as a backup only)
/original-assets/

# scratch scripts (e.g. mobile screenshot QA tooling)
/.scripts-tmp/

# local dev "database" — generated on first run from the seed catalogue,
# then mutated by the admin panel. Not meant to be committed, same as you
# wouldn't commit a local sqlite/dev.db file. See src/lib/server/jsonStore.ts.
/data/*.json

# admin-uploaded media (local dev storage) — see src/lib/server/mediaStorage.ts
/public/uploads/
